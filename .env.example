# Discord webhook URL (leave empty to run in DRY_RUN mode)
DISCORD_WEBHOOK_URL=your_discord_webhook_url_here

# Polling interval (minutes)
CHECK_INTERVAL_MIN=5

# Thresholds
ADD_RATE_THRESHOLD=4.0
DROP_RATE_THRESHOLD=4.0
MIN_ABS_ADD_DELTA=15
MIN_ABS_DROP_DELTA=15

# Smoothing: number of recent snapshots to average (use >= 1)
SMOOTHING_N=3

# Max alerts per player per UTC day
MAX_ALERTS_PER_PLAYER=3

# Flood control
MAX_ALERTS_PER_ITERATION=10
EMBED_ALERTS_PER_MESSAGE=10
MAX_DISCORD_RETRIES=3

# If true, don't send to Discord; log to console instead
DRY_RUN=false

# Networking
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36
REQUEST_TIMEOUT_SECONDS=30
REQUEST_RETRY_MAX=4
REQUEST_RETRY_BACKOFF_START=1.0
REQUEST_RETRY_BACKOFF_MAX=8.0
REQUEST_RETRY_JITTER=0.25
HTTP2_ENABLED=false

